<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/Layout"
        android:layout_width="729dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="-22dp">

        <ImageButton
            android:id="@+id/Registro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="584dp"
            android:layout_marginTop="223dp"
            android:layout_marginEnd="89dp"
            android:layout_marginBottom="455dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_send" />

        <EditText
            android:id="@+id/Identificador"
            android:layout_width="256dp"
            android:layout_height="44dp"
            android:layout_marginStart="87dp"
            android:layout_marginTop="84dp"
            android:layout_marginEnd="112dp"
            android:ems="10"
            android:inputType="text"
            android:text="ID del Uruk-hai"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <Spinner
            android:id="@+id/Unidad"
            android:layout_width="395dp"
            android:layout_height="24dp"
            android:layout_marginStart="7dp"
            android:layout_marginTop="143dp"
            android:layout_marginEnd="7dp"
            android:layout_marginBottom="562dp"
            android:entries="@array/Unidad"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <RadioGroup
            android:id="@+id/Grupo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="33dp"
            android:layout_marginTop="225dp"
            android:layout_marginEnd="93dp"
            android:layout_marginBottom="398dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <RadioButton
                android:id="@+id/Armadura"
                android:layout_width="218dp"
                android:layout_height="47dp"
                android:text="Armadura de Hierro"
                tools:layout_editor_absoluteX="47dp"
                tools:layout_editor_absoluteY="366dp" />

            <RadioButton
                android:id="@+id/Escudo"
                android:layout_width="283dp"
                android:layout_height="59dp"
                android:text="Escudo de Isengard" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/Antorcha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="337dp"
            android:layout_marginTop="226dp"
            android:layout_marginEnd="182dp"
            android:layout_marginBottom="455dp"
            android:text="Llevar Antorcha de Polvorín"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>